<?xml version="1.0" encoding="UTF-8"?>
<!-- VDDI-100 test vectors : Aardvark Control Center batch  interface=SPI  byte_order=little -->
<aardvark>
  <configure i2c="0" spi="1" gpio="0" tpower="1" pullups="0"/>
  <spi_config polarity="rising/falling" phase="sample/setup" bitorder="msb" ss="active_low"/>
  <spi_bitrate khz="1000"/>
  <!-- SPI Mode 0, MSB first, frame = [R/W|ADDR(7)] [DATA(8)] -->
  <!-- ## T01 Chip ID / 바이트 순서 확인  <- 01_input/testvector/tv_t01_id_check.v -->
  <!-- chip_reset : RST_N low -> high (board GPIO / FPGA) -->
  <sleep ms="10"/>                                                <!-- 00000 L8 reset -->
  <spi_write count="2" radix="16">80 00</spi_write>               <!-- 00001 L9 CHIP_ID ID  expect 0xA5 mask 0xFF -->
  <spi_write count="2" radix="16">81 00</spi_write>               <!-- 00002 L9 CHIP_ID ID  expect 0xD1 mask 0xFF -->
</aardvark>
